<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:UOMapWeaver.App.Views"
        x:Class="UOMapWeaver.App.Views.MainWindow"
        Title="UOMapWeaver"
        Width="1240"
        Height="900">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Padding="6" Background="#1E1E1E">
      <DockPanel>
        <ToggleButton Name="LogsToggle" Content="Log" DockPanel.Dock="Left"
                      ToolTip.Tip="Toggle the log overlay to view operation history" />
        <ToggleButton Name="SaveStateToggle" Content="Save Fields" DockPanel.Dock="Right"
                      ToolTip.Tip="When enabled, field values are saved and restored between sessions" />
        <Button Name="ResetStateButton" Content="Reset Fields" DockPanel.Dock="Right"
                ToolTip.Tip="Clear all saved field values. Restart to apply." />
        <Button Name="DataReadmeButton" Content="Data" DockPanel.Dock="Right"
                ToolTip.Tip="Open the UOMapWeaverData folder README" />
        <Button Name="OpenLogFileButton" Content="Open Log" DockPanel.Dock="Right"
                ToolTip.Tip="Open the current session log file in the default text editor" />
        <Button Name="OpenLogFolderButton" Content="Log Folder" DockPanel.Dock="Right"
                ToolTip.Tip="Open the log folder in file explorer" />
        <Button Name="CancelButton" Content="Stop" DockPanel.Dock="Right" IsEnabled="False"
                ToolTip.Tip="Cancel the current operation" />
        <SelectableTextBlock Name="BannerText" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap">
          <SelectableTextBlock.Inlines>
            <Run Name="BannerTimestampRun" Text="[00:00:00.000]" Foreground="#9A9A9A" />
            <Run Text=" " />
            <Run Name="BannerMessageRun" Text="Ready." Foreground="White" />
          </SelectableTextBlock.Inlines>
        </SelectableTextBlock>
      </DockPanel>
    </Border>
    <TabControl Name="MainTabControl" Grid.Row="1" Margin="8">
      <TabItem ToolTip.Tip="Quick start guide, version info, and links to each tool">
        <TabItem.Header>
          <TextBlock Text="Welcome" />
        </TabItem.Header>
        <ScrollViewer Padding="16">
          <StackPanel Spacing="16">
            <TextBlock Name="WelcomeVersionText" FontSize="20" FontWeight="Bold" Text="UOMapWeaver" />
            <TextBlock TextWrapping="Wrap" Foreground="#CCCCCC"
                       Text="A desktop tool for Ultima Online map creation and editing. Convert between MUL/BMP formats, generate statics, copy map regions, manage tile colors, and more." />

            <Border BorderBrush="#3A3A3A" BorderThickness="1" Padding="12" CornerRadius="4">
              <StackPanel Spacing="8">
                <TextBlock Text="Tools" FontWeight="Bold" FontSize="16" />

                <Button Name="GoTileColors" Content="Tile Colors — Build tile-to-color JSON from client data"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="Generate a JSON mapping of tile IDs to RGB colors from radarcol.mul or tiledata.mul" />
                <Button Name="GoUopTools" Content="UOP Pack/Unpack — Convert between UOP and MUL formats"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="Pack MUL files into UOP format or extract MUL files from UOP archives" />
                <Button Name="GoMulToBmp" Content="MUL to BMP — Export map.mul terrain to a BMP image"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="Read a map.mul file and render it as an 8-bit or 24-bit BMP image" />
                <Button Name="GoBmpToMul" Content="BMP to MUL — Convert BMP images into map.mul terrain"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="Convert altitude and terrain BMP images back into a map.mul file" />
                <Button Name="GoGenStatics" Content="Gen Statics — Generate statics from placement rules"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="Generate statics.mul and staidx.mul from XML placement definitions" />
                <Button Name="GoBlankBmp" Content="Blank BMP — Create empty BMP canvases for map editing"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="Create blank 8-bit BMP images at standard UO map dimensions" />
                <Button Name="GoMapCopy" Content="Map Copy — Copy terrain and statics between maps"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="Copy rectangular regions of terrain and statics from one map to another" />
                <Button Name="GoVerdataMerger" Content="Verdata Merge — Merge verdata.mul patches into base MUL files"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="Apply verdata.mul patches directly into tiledata.mul, Art.mul, etc. to produce unified MUL files" />
                <Button Name="GoResourcePack" Content="Resource Pack — Build Minecraft-style pack from UO client files"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="Extract all sprites, sounds, music, and metadata into a ResourcePack for MondainGate" />
              </StackPanel>
            </Border>

            <Border BorderBrush="#3A3A3A" BorderThickness="1" Padding="12" CornerRadius="4">
              <StackPanel Spacing="6">
                <TextBlock Text="Recent Paths" FontWeight="Bold" FontSize="16" />
                <TextBlock Name="WelcomeRecentPathsText" TextWrapping="Wrap" Foreground="#AAAAAA"
                           Text="No saved paths yet. Use the tools above and enable Save Fields to remember your paths." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem ToolTip.Tip="Build tile-to-color JSON from client radarcol.mul or tiledata.mul">
        <TabItem.Header>
          <TextBlock Text="Tile Colors" />
        </TabItem.Header>
        <views:TileColorMapView />
      </TabItem>
      <TabItem ToolTip.Tip="Pack MUL files into UOP or extract MUL from UOP archives">
        <TabItem.Header>
          <TextBlock Text="UOP Pack/Unpack" />
        </TabItem.Header>
        <views:UopToolsView />
      </TabItem>
      <TabItem ToolTip.Tip="Export map.mul terrain to a BMP image for editing">
        <TabItem.Header>
          <TextBlock Text="MUL to BMP" />
        </TabItem.Header>
        <views:MulToBmpView />
      </TabItem>
      <TabItem ToolTip.Tip="Convert altitude and terrain BMP images into map.mul">
        <TabItem.Header>
          <TextBlock Text="BMP to MUL" />
        </TabItem.Header>
        <views:BmpToMulView />
      </TabItem>
      <TabItem ToolTip.Tip="Generate statics.mul and staidx.mul from XML placement rules">
        <TabItem.Header>
          <TextBlock Text="Gen Statics" />
        </TabItem.Header>
        <views:GenStaticsView />
      </TabItem>
      <TabItem ToolTip.Tip="Create blank 8-bit BMP canvases at standard UO map dimensions">
        <TabItem.Header>
          <TextBlock Text="Blank BMP" />
        </TabItem.Header>
        <views:BlankBmpView />
      </TabItem>
      <TabItem ToolTip.Tip="Copy rectangular regions of terrain and statics between maps">
        <TabItem.Header>
          <TextBlock Text="Map Copy" />
        </TabItem.Header>
        <views:MapCopyView />
      </TabItem>
      <TabItem ToolTip.Tip="Merge verdata.mul patches into base MUL files to eliminate the verdata dependency">
        <TabItem.Header>
          <TextBlock Text="Verdata Merge" />
        </TabItem.Header>
        <views:VerdataMergerView />
      </TabItem>
      <TabItem ToolTip.Tip="Build a Minecraft-style Resource Pack from UO client files for MondainGate">
        <TabItem.Header>
          <TextBlock Text="Resource Pack" />
        </TabItem.Header>
        <views:ResourcePackView />
      </TabItem>
    </TabControl>
    <Grid Name="LogOverlay" Grid.Row="1" IsVisible="False">
      <Border Background="#DD000000" IsHitTestVisible="False" />
      <Border BorderBrush="#3A3A3A"
              BorderThickness="1"
              Background="#CC1E1E1E"
              Padding="8"
              Margin="10"
              VerticalAlignment="Stretch">
        <ListBox Name="LogList"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectionMode="Multiple">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Select All" Click="OnSelectAllLogs" />
              <MenuItem Header="Copy Selected" Click="OnCopySelectedLogs" />
              <MenuItem Header="Copy All" Click="OnCopyAllLogs" />
              <Separator />
              <MenuItem Header="Export Log..." Click="OnExportLog" />
              <MenuItem Header="Clear Log" Click="OnClearLog" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:CompileBindings="False">
              <SelectableTextBlock TextWrapping="Wrap" Margin="0">
                <SelectableTextBlock.Inlines>
                  <Run Text="{Binding Timestamp}" Foreground="{Binding TimestampForeground}" />
                  <Run Text=" " />
                  <Run Text="{Binding Message}" Foreground="{Binding MessageForeground}" />
                </SelectableTextBlock.Inlines>
              </SelectableTextBlock>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>
    <Border Grid.Row="2" Padding="6" Background="#1E1E1E">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ProgressBar Name="GlobalProgressBar" Width="240" Height="10" Minimum="0" Maximum="100" IsVisible="False" />
        <TextBlock Name="GlobalProgressText" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
