<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UOMapWeaver.App.Views.WorldFormatView">
  <ScrollViewer>
    <StackPanel Margin="8" Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="World format" VerticalAlignment="Center" />
        <ComboBox Name="PluginComboBox" Width="260" />
        <TextBlock Name="PluginStatusText" VerticalAlignment="Center" />
      </StackPanel>

      <Border BorderBrush="#3A3A3A" BorderThickness="1" Padding="8">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">
          <TextBlock Grid.ColumnSpan="2" Text="Import a map area into a world" FontWeight="Bold" />
          <TextBlock Grid.Row="1" Text="Map (MUL or UOP)" VerticalAlignment="Center" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBox Name="ImportMapBox" Width="320" />
            <Button Content="Browse" Click="OnBrowseImportMap" />
          </StackPanel>
          <TextBlock Grid.Row="2" Text="staidx.mul" VerticalAlignment="Center" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBox Name="ImportStaIdxBox" Width="320" />
            <Button Content="Browse" Click="OnBrowseImportStaIdx" />
          </StackPanel>
          <TextBlock Grid.Row="3" Text="statics.mul" VerticalAlignment="Center" />
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBox Name="ImportStaticsBox" Width="320" />
            <Button Content="Browse" Click="OnBrowseImportStatics" />
          </StackPanel>
          <TextBlock Grid.Row="4" Text="Map size (tiles)" VerticalAlignment="Center" />
          <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBox Name="MapWidthBox" Width="80" Text="7168" />
            <TextBlock Text="x" VerticalAlignment="Center" />
            <TextBox Name="MapHeightBox" Width="80" Text="4096" />
            <TextBlock Text="UOP map index" VerticalAlignment="Center" />
            <TextBox Name="UopIndexBox" Width="50" Text="0" />
          </StackPanel>
          <TextBlock Grid.Row="5" Text="Area (multiples of 8)" VerticalAlignment="Center" />
          <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="x" VerticalAlignment="Center" /><TextBox Name="AreaXBox" Width="70" Text="0" />
            <TextBlock Text="y" VerticalAlignment="Center" /><TextBox Name="AreaYBox" Width="70" Text="0" />
            <TextBlock Text="w" VerticalAlignment="Center" /><TextBox Name="AreaWBox" Width="70" Text="512" />
            <TextBlock Text="h" VerticalAlignment="Center" /><TextBox Name="AreaHBox" Width="70" Text="512" />
          </StackPanel>
          <TextBlock Grid.Row="6" Text="World folder" VerticalAlignment="Center" />
          <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBox Name="ImportWorldBox" Width="320" />
            <Button Content="Browse" Click="OnBrowseImportWorld" />
          </StackPanel>
          <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
            <Button Name="ImportButton" Content="Import" Click="OnImport" />
            <TextBlock Name="ImportStatusText" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <Border BorderBrush="#3A3A3A" BorderThickness="1" Padding="8">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">
          <TextBlock Grid.ColumnSpan="2" Text="Export a world to map, staidx and statics MUL" FontWeight="Bold" />
          <TextBlock Grid.Row="1" Text="World folder" VerticalAlignment="Center" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBox Name="ExportWorldBox" Width="320" />
            <Button Content="Browse" Click="OnBrowseExportWorld" />
          </StackPanel>
          <TextBlock Grid.Row="2" Text="Block area (unbounded worlds)" VerticalAlignment="Center" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="x" VerticalAlignment="Center" /><TextBox Name="BlockXBox" Width="70" Text="0" />
            <TextBlock Text="y" VerticalAlignment="Center" /><TextBox Name="BlockYBox" Width="70" Text="0" />
            <TextBlock Text="w" VerticalAlignment="Center" /><TextBox Name="BlockWBox" Width="70" />
            <TextBlock Text="h" VerticalAlignment="Center" /><TextBox Name="BlockHBox" Width="70" />
          </StackPanel>
          <TextBlock Grid.Row="3" Text="Output folder" VerticalAlignment="Center" />
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBox Name="ExportOutputBox" Width="320" />
            <Button Content="Browse" Click="OnBrowseExportOutput" />
          </StackPanel>
          <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Foreground="#AAAAAA"
                     Text="Writes map0.mul, staidx0.mul and statics0.mul. Leave the block area empty to export a bounded world whole." />
          <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
            <Button Name="ExportButton" Content="Export" Click="OnExport" />
            <TextBlock Name="ExportStatusText" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
